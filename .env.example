# DevPulse AI / DevPilot — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets.

# GitHub REST API Token (optional but recommended — increases rate limit from 60 to 5000 requests/hour)
# Create a classic token at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only)
GITHUB_TOKEN=

# AI Provider API Key — Required for Phase 4 Codebase RAG & Grounded Q&A (Optional: fallback to local deterministic synthesizer if unset)
# Google Gemini API Key (Recommended): https://aistudio.google.com
GEMINI_API_KEY=
# or OpenAI API Key: https://platform.openai.com
OPENAI_API_KEY=
# Generic fallback AI Key
AI_API_KEY=

# GitHub Webhook Secret — Required for Phase 9 GitHub Webhooks signature verification (X-Hub-Signature-256)
GITHUB_WEBHOOK_SECRET=

# Next.js port (default: 3005 — configured in package.json scripts)
# PORT=3005
