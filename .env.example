# DevPulse AI / DevPilot — Environment Variables
# Copy this file to .env.local and fill in your actual values.
# NEVER commit .env.local or any file containing real secrets.

# GitHub REST API Token (optional but recommended — increases rate limit from 60 to 5000 requests/hour)
# Create a classic token at: https://github.com/settings/tokens
# Required scopes: public_repo (read-only)
GITHUB_TOKEN=

# AI Provider API Key — not used in Phase 0. Required in Phase 4+ for bullet rewrites and codebase Q&A.
# AI_API_KEY=

# Next.js port (default: 3005 — configured in package.json scripts)
# PORT=3005
