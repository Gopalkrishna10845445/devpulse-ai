# DevPulse AI / DevPilot — Environment Variables Template
# Copy this file to .env.local and configure your actual values.
# NEVER commit .env.local or any file containing real secrets.

# 1. PostgreSQL 16 + pgvector Database URL (Optional: defaults to in-memory store if unset)
# Example local docker connection string: postgresql://username:password@localhost:5432/devpilot
DATABASE_URL=postgresql://devpilot:password@localhost:5432/devpilot

# 2. Redis 7 URL for Distributed Caching, Rate Limiting & BullMQ (Optional: defaults to in-memory fallback if unset)
# Example local docker connection string: redis://localhost:6379
REDIS_URL=redis://localhost:6379

# 3. GitHub OAuth Application Credentials (Required for Phase 2 Production Authentication)
# Register an OAuth app at https://github.com/settings/developers
# Authorization callback URL: http://localhost:3005/api/auth/callback
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_OAUTH_REDIRECT_URI=http://localhost:3005/api/auth/callback

# 4. GitHub App Integration (Production Phase 4 — Scoped Installation Tokens)
GITHUB_APP_ID=your_github_app_id_here
GITHUB_APP_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\nMIIEowIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"

# 5. OpenTelemetry OTLP Collector Endpoint (Optional)
# OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318

# 6. Server-side GitHub PAT (Optional: fallback for public repository ingestion)
# Required scopes: public_repo (read-only)
GITHUB_TOKEN=your_github_personal_access_token_here

# 4. AI Provider API Key — Required for Phase 4 RAG, Fix Proposer, and PR Review
# Google Gemini API Key: https://aistudio.google.com
GEMINI_API_KEY=your_gemini_api_key_here
# or OpenAI API Key: https://platform.openai.com
OPENAI_API_KEY=your_openai_api_key_here
# Generic fallback AI Key
AI_API_KEY=

# 5. GitHub Webhook Secret — Required for Phase 9 Webhook HMAC-SHA256 signature verification
GITHUB_WEBHOOK_SECRET=your_github_webhook_secret_here

# 6. Next.js Port (Default: 3005)
# PORT=3005
